          "description": "城市名称，取 city_list 返回的名称（名称与编码是同一个值）",
          "type": "string",
        },
        "country": {
          "description": "国家编码（ISO 3166-1 二字码），多个以英文逗号分隔，如 US,JP；可选国家用 country_list 查",
          "type": "string",
        },
        "num": {
          "description": "要新增的子账号数量，1 到 500",
          "type": "integer",
        },
        "product": {
          "description": "产品：dynamic-no-expiry=动态住宅流量（永久），dynamic-monthly=动态住宅流量（期限）",
          "enum": [
            "dynamic-no-expiry",
            "dynamic-monthly",
          ],
          "type": "string",
        },
        "remark": {
          "description": "备注",
          "type": "string",
        },
        "spec": {
          "description": "指定一个资源池编号，取 provider_list 返回的字符串数组元素并转为整数，只能传一个；期限流量需另外确认资源池适用性",
          "type": "integer",
